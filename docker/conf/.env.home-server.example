# Registry-first application images (published from the fork's master branch)
OPENCVE_WEBSERVER_IMAGE=ghcr.io/ozwicked/opencve-webserver:latest
OPENCVE_AIRFLOW_IMAGE=ghcr.io/ozwicked/opencve-airflow:latest

# OpenCVE release baked into both application images
COMPOSE_PROJECT_NAME=opencve
OPENCVE_REPOSITORY=https://github.com/opencve/opencve.git
OPENCVE_VERSION=v3.1.0

# LAN-facing OpenCVE UI; Airflow stays loopback-only
OPENCVE_BIND_ADDRESS=192.168.178.57
OPENCVE_PORT=8092
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_WEBSERVER_PORT=8093

# Replaced locally by prepare-home-server.py. Never commit generated values.
POSTGRES_USER=opencve
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VERSION=15
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME

# Conservative limits for the 4 GiB home server.
GUNICORN_CMD_ARGS="--workers 1 --threads 2 --access-logfile '-'"
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__PARALLELISM=2
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=1
AIRFLOW__CELERY__WORKER_CONCURRENCY=1
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/opencve
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/opencve
AIRFLOW__CELERY__BROKER_URL=redis://:@redis/1
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION='true'
AIRFLOW__CORE__LOAD_EXAMPLES='false'
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__API__AUTH_BACKENDS='airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session'
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK='true'
SQLALCHEMY_SILENCE_UBER_WARNING=1
